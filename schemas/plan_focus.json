{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan_focus",
  "description": "Parts of the plan worth a closer look (PLAN_VISUALS_SPEC section 3a). Boxes are fractions of the overview image (0-1, y down). Code checks every box; an area only asks for a close-up and changes nothing.",
  "type": "object",
  "properties": {
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "reason": {
            "type": "string"
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "box",
          "reason",
          "item_ids"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "areas",
    "notes"
  ],
  "additionalProperties": false
}
