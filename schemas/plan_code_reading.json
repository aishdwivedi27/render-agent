{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan_code_reading",
  "description": "plan/<dwelling>/code_reading.json: what the code read from the drawing itself, with no model (PLAN_VISUALS_SPEC section 3): rooms, openings, recesses, connections, wall rows from the overlay check against the drawing, and how far each item is from a drawn wall. Coordinates are mm in the page frame at the drawing scale (y down).",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outline": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "area_m2": {
            "type": "number"
          },
          "width_mm": {
            "type": "integer"
          },
          "depth_mm": {
            "type": "integer"
          },
          "outdoor": {
            "type": "boolean"
          },
          "shares_with": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The other zones of the open space this room is one part of (empty for a room walled in on its own)"
          }
        },
        "required": [
          "id",
          "name",
          "labels",
          "outline",
          "area_m2",
          "width_mm",
          "depth_mm",
          "outdoor",
          "shares_with"
        ],
        "additionalProperties": false
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "alternative": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "frame": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "axis": {
            "type": "string"
          },
          "width_mm": {
            "type": "integer"
          },
          "position_mm": {
            "type": "integer"
          },
          "wall_line_mm": {
            "type": "integer"
          },
          "exterior": {
            "type": "boolean"
          },
          "hinge_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "swing_side": {
            "type": [
              "integer",
              "null"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "code_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "off_drawing_mm": {
            "type": "integer"
          },
          "leaf_mm": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size_check": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "matches",
              "differs",
              null
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "alternative",
          "confidence",
          "evidence",
          "frame",
          "axis",
          "width_mm",
          "position_mm",
          "wall_line_mm",
          "exterior",
          "hinge_end",
          "swing_side",
          "code",
          "code_note",
          "rooms",
          "off_drawing_mm",
          "leaf_mm",
          "size_check"
