        "required": [
          "id",
          "off_drawing_mm"
        ],
        "additionalProperties": false
      }
    },
    "kitchen": {
      "type": "array",
      "description": "Kitchen detail read by code: island, fridge space, dishwasher provision (rect in mm, page frame)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "room": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "alternative": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "rect",
          "room",
          "evidence",
          "confidence",
          "alternative"
