          "depth_mm": {
            "type": "integer"
          },
          "length_mm": {
            "type": "integer"
          },
          "off_drawing_mm": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "alternative",
          "confidence",
          "evidence",
          "rect",
          "room",
          "room_name",
          "source",
          "depth_mm",
          "length_mm",
          "off_drawing_mm"
        ],
        "additionalProperties": false
      }
    },
    "wall_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "confidence": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "box",
          "confidence",
          "evidence",
          "question"
        ],
        "additionalProperties": false
      }
