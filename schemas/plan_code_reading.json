        "additionalProperties": false
      }
    },
    "recesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "alternative": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "room": {
            "type": "string"
          },
          "room_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
